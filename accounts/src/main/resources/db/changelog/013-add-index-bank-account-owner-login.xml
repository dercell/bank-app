<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="13" author="sergey.kolotev">
        <preConditions onFail="WARN">
            <not>
                <indexExists tableName="bank_account" indexName="idx_bank_account_owner_login"/>
            </not>
        </preConditions>
        <createIndex tableName="bank_account" indexName="idx_bank_account_owner_login">
            <column name="owner_login"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="bank_account" indexName="idx_bank_account_owner_login"/>
        </rollback>
    </changeSet>

</databaseChangeLog>