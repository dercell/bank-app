<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="10" author="sergey.kolotev">
        <preConditions onFail="WARN">
            <not>
                <tableExists tableName="bank_account"/>
            </not>
        </preConditions>
        <createTable tableName="bank_account">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_num" type="VARCHAR(100)" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="owner_login" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="balance" type="DECIMAL(19,2)"/>
        </createTable>
        <rollback>
            <dropTable tableName="bank_account"/>
        </rollback>
    </changeSet>

</databaseChangeLog>